-    theSimSpeed = 1000;
+    // A regression run has nobody watching it at human speed, so play it faster. The
+    // advance per step is simStep()*2*theSimSpeed ms = 0.008*theSimSpeed, against 4ms of
+    // physics, so the rate is 500/theSimSpeed: 1000 is half real time, 125 is 4x.
+    //
+    // NOT 60, which is what Shift+F uses. addMSecs takes an int and 0.008*60 = 0.48
+    // truncates to ZERO, so the simulated clock never advances, the loop below always runs
+    // its full 25 steps, and the event loop is saturated. Levels that end on a win or death
+    // signal still finished, because those short-circuit the state machine; levels whose
+    // empty run has to TIME OUT hung forever, because the regression timer never got
+    // serviced. 125 keeps the advance at a whole millisecond.
+    theSimSpeed = theIsRunAsRegression ? 125 : 1000;
     theFramesPerSecond = 0;
     emit theTimer.start(1000 / MAX_FPS);
 
